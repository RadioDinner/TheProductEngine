# Session cookie signing secret — set a long random value in production.
SESSION_SECRET=

# When set, real SMS sending is assumed and the dev notices/simulator disappear.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Portal → Account → Public Key; enables webhook signature verification.
TELNYX_PUBLIC_KEY=

# Protects /api/cron/digests; Vercel cron sends it automatically when set.
CRON_SECRET=

# Comma-separated 10-digit phone numbers whose accounts get the /admin portal.
ADMIN_PHONES=

# Where new-ad review notifications are emailed (needs RESEND_API_KEY). Optional.
ADMIN_EMAIL=

# --- The call-in card line (/api/voice), FEATURES item 31 ---
# Twilio Console → Account Info → Auth Token. REQUIRED in production: without
# it every voice webhook is rejected (a forged one could attach cards to any
# number). Point the Twilio number's "A call comes in" webhook (POST) at
# https://<site>/api/voice — every later stage is handled by that one URL.
# Account SID (starts "AC"). Needed for line-type lookups (Settings ->
# Number checks); the auth token below is the other half of that Basic auth
# pair, and is also what validates the /api/voice webhook signature.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Stripe Pay Connector's unique name from the Twilio console. Default:
TWILIO_PAY_CONNECTOR=Default
# Comma-separated 10-digit numbers that ring BEFORE the attendant answers
# (yours, your wife's). Empty = the attendant picks up immediately.
VOICE_RING_TO=
# Seconds those phones ring first. Keep it under the cells' own voicemail
# delay (~25-30s) or a personal voicemail answers instead of the attendant.
VOICE_RING_SECONDS=18

# When set, real Stripe checkout replaces the dev payment simulation.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook endpoint (/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=

# When set, real email sending is assumed and the dev email viewer disappears.
RESEND_API_KEY=
EMAIL_FROM="The Plain Exchange <ads@theplainexchange.com>"
# Signing secret (whsec_…) for the Resend Inbound webhook (/api/email/inbound),
# which subscribes anyone who emails subscribe@theplainexchange.com. Required in
# production for that route to accept requests (fails closed without it).
RESEND_WEBHOOK_SECRET=
# The inbound address people email to subscribe. Defaults to the value below.
EMAIL_INBOUND_ADDRESS=subscribe@theplainexchange.com

# Absolute base URL used in email links and images (production: the real domain).
SITE_URL=

# When both are set, the app switches from local fixtures to Supabase.
# See supabase/README.md for setup. The service-role key is a server-only secret.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Analytics 4 (see analytics/) ---
# Web data stream measurement id, "G-XXXXXXXXXX". PUBLIC — it ships in the page.
# Set it on the PRODUCTION environment ONLY: an unset id is what keeps preview
# and local builds out of the property, which beats any runtime environment check.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Measurement Protocol API secret (GA4 Admin -> Data streams -> your stream ->
# Measurement Protocol API secrets). SERVER ONLY — it authorises writing events
# into the property. Never give this a NEXT_PUBLIC_ prefix.
GA_API_SECRET=
# Salt for hashing member phone numbers into GA user ids. SERVER ONLY, and a
# real secret: there are only ten billion US phone numbers, so anyone holding
# the salt can reverse every hash by brute force. openssl rand -hex 32.
# Rotating it resets user continuity in GA — new hashes, new users.
ANALYTICS_SALT=
# Set to 1 to send server events to GA's VALIDATION endpoint instead of the real
# one: it reports what is wrong and stores nothing. The live endpoint returns 204
# even for payloads it discards, so this is the only honest way to test an event.
# LEFT ON IN PRODUCTION IT IS A SILENT OUTAGE — /api/health reports it.
GA_VALIDATE_ONLY=
# Set to 1 to add debug_mode to every server event, which is what makes them
# visible in GA4's DebugView. Measurement Protocol events do NOT appear there
# by default, so without this a freshly wired integration is unverifiable until
# the standard reports catch up (up to 48h). Turn on to verify, then off.
GA_DEBUG_MODE=
